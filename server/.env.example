# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication (JWT)
JWT_SECRET=supersecretcollegeinformationassistantjwtkey2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local SQLite fallback (zero config): sqlite+aiosqlite:///./college_rag.db
# For PostgreSQL / Supabase with pgvector: postgresql+asyncpg://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./college_rag.db

# LLM & Embedding Providers
# Supported providers: "gemini", "openai", "local"
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (optional)
OPENAI_API_KEY=

# RAG Hyperparameters (as specified in spec.md)
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=5
SIMILARITY_THRESHOLD=0.55
HYBRID_SEARCH=true

# Upload Storage Directory
UPLOAD_DIR=./uploads
